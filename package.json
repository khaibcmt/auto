{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll && mkdir -p docs/assets && cp dist/index.html dist/404.html dist/.nojekyll docs/ && cp dist/assets/app.* docs/assets/",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": ">=0.1.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@vitejs/plugin-react": ">=4.0.0",
    "lucide-react": ">=0.400.0",
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0",
    "vite": ">=5.0.0",
    "express": "^4.18.0",
    "dotenv": ">=16.0.0",
    "motion": ">=11.0.0"
  },
  "devDependencies": {
    "@types/node": ">=20.0.0",
    "@types/react": ">=18.3.0",
    "@types/react-dom": ">=18.3.0",
    "autoprefixer": ">=10.4.0",
    "esbuild": ">=0.20.0",
    "tailwindcss": ">=4.0.0",
    "tsx": ">=4.0.0",
    "typescript": ">=5.0.0",
    "@types/express": "^4.17.17"
  }
}
